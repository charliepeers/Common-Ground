# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required for live mode.
ANTHROPIC_API_KEY=

# Evidence search: the first pass on every sentence, follow-up searches, and the perspectives lane.
# Without it, facts go to Claude's own web search (slower) and perspectives are off.
EXA_API_KEY=

# Server speech-to-text with speaker labels. Set one. AssemblyAI is used if both are set,
# unless STT_PROVIDER says otherwise. With neither, the microphone can't be used.
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=
# STT_PROVIDER=deepgram

# Models by role; README "Model and vendor choices" has the numbers behind the defaults.
# LIVE_MODEL=claude-sonnet-5-5
# CHECK_EFFORT=low
# PUSHBACK_MODEL=claude-sonnet-5-5
# PUSHBACK_EFFORT=high

# How much reaches the screen: references on a verdict, and voices on a contested claim or a value.
# MAX_SOURCES=2
# MAX_TAKES=2

# Fast mode (faster output, premium price) exists only on Opus 5, 5.5 and 4.8, and is used when a role
# runs on one of them. It falls back to standard speed by itself if your key can't use it. FAST_MODE=0 turns it off.
# FAST_MODE=0
